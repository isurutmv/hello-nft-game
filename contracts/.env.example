# Deployer key for BSC testnet (fund it with tBNB from https://www.bnbchain.org/en/testnet-faucet)
PRIVATE_KEY=
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Optional: verify contracts on testnet.bscscan.com
ETHERSCAN_API_KEY=

# Chainlink VRF v2.5 on BSC testnet. Leave VRF_SUB_ID empty and the deploy script
# creates a subscription and funds it with VRF_FUND_BNB of native tBNB.
VRF_SUB_ID=
VRF_FUND_BNB=0.1
